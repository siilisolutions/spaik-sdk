{
    "name": "spaik-sdk-material",
    "version": "1.0.0-rc.1",
    "description": "Material UI components for Spaik SDK - themeable chat UI for AI agents",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/siilisolutions/spaik-sdk.git",
        "directory": "packages/agent-sdk-material"
    },
    "homepage": "https://github.com/siilisolutions/spaik-sdk#readme",
    "bugs": {
        "url": "https://github.com/siilisolutions/spaik-sdk/issues"
    },
    "author": {
        "name": "Siili Solutions Oyj",
        "email": "info@siili.com",
        "url": "https://siili.com"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "bun run tsc",
        "dev": "bun run tsc --watch",
        "lint": "bun run eslint src --ext .ts,.tsx",
        "lint:fix": "bun run eslint src --ext .ts,.tsx --fix",
        "type-check": "bun run tsc --noEmit",
        "test": "bunx playwright test --config ../../playwright.config.ts"
    },
    "peerDependencies": {
        "@emotion/react": "^11.11.0",
        "@emotion/styled": "^11.11.0",
        "@mui/material": "^5.15.0 || ^6.0.0 || ^7.0.0 || ^9.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "spaik-sdk-react": "^1.0.0-rc.1"
    },
    "dependencies": {
        "react-markdown": "^9.0.1",
        "remark-gfm": "^4.0.0"
    },
    "devDependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@mui/material": "^9.5.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "eslint": "^8.57.1",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "spaik-sdk-react": "workspace:*",
        "typescript": "^5.3.3"
    },
    "keywords": [
        "react",
        "material-ui",
        "mui",
        "agent",
        "ai",
        "llm",
        "chat",
        "ui",
        "components",
        "spaik"
    ]
}
