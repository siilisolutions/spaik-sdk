# Copy to .env and set what your application uses. Everything here is optional unless noted.

# Default model for agents created without llm_model. A preset name or alias (sonnet, opus,
# haiku, gpt, gemini flash) or any model ID. MODEL_PROVIDER selects the provider; it is inferred
# for claude-*, gpt-* and gemini-* IDs and required for other IDs.
DEFAULT_MODEL=sonnet
# anthropic, openai, google, azure, foundry, ollama, deepseek, xai, cohere or mistral
# MODEL_PROVIDER=anthropic

# Provider API keys
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# COHERE_API_KEY=
# MISTRAL_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Azure OpenAI (MODEL_PROVIDER=azure). The deployment name is the model ID. GPT-5 and later use
# the Responses API, which needs API version 2025-03-01-preview or later. Omit AZURE_API_KEY
# when passing azure_ad_token_provider to AzureProvider for Entra ID.
# AZURE_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2025-04-01-preview
# AZURE_API_KEY=your-azure-api-key

# Azure AI Foundry project (MODEL_PROVIDER=foundry)
# AZURE_FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# AZURE_FOUNDRY_API_KEY=your-foundry-api-key

# Send model calls through a gateway: each provider client uses this base URL, key and headers
# in place of its own endpoint and API key.
# LLM_AUTH_MODE=proxy
# LLM_PROXY_BASE_URL=https://your-proxy.example.com
# LLM_PROXY_API_KEY=your-proxy-key
# LLM_PROXY_HEADERS=X-Team:agents,X-Env:dev

# Audio and image generation
# STT_MODEL=whisper-1
# TTS_MODEL=tts-1
# IMAGE_MODEL=gpt-image-1.5

# Prompts, tracing and logging
# PROMPTS_DIR=prompts
# PROMPT_LOADER_MODE=local
# TRACE_SINK_MODE=local
# LOG_LEVEL=INFO
